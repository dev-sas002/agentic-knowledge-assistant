# Every variable below has a working default; this file exists to document
# them, not because the app needs it. Copy to .env only to change something.

# ---- Vector DB & embeddings ----
CHROMA_DB_DIR=data/chroma
RAW_DOCS_DIR=data/raw
# The indexer and the agent must agree on the collection name.
CHROMA_COLLECTION=pwb_docs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# `sentence-transformers` (real, local, 130MB) or `hashing` (dependency-free,
# not semantic — for CI and for proving the embedder seam is a seam).
EMBEDDER_PROVIDER=sentence-transformers
# Where embedding vectors are cached between runs. Empty disables the cache.
EMBEDDING_CACHE_PATH=data/embedding_cache.sqlite3

# ---- Retrieval ----
# Upper bound on top_k, whatever the UI asks for. top_k multiplies directly
# into prompt tokens, so this is a cost control as much as a quality one.
MAX_TOP_K=12

# ---- Answer provider ----
# `auto` uses Groq when a key is present and the extractive composer when it
# is not. Name a provider to override.
LLM_PROVIDER=auto
# Leave empty to run fully offline: answers are then composed extractively
# from the retrieved text, with real citations.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Per-request timeout in seconds, and retries on transient failures.
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
MAX_ANSWER_TOKENS=768
# Published USD per million tokens, used by the cost panel and eval harness.
GROQ_INPUT_USD_PER_MTOK=0.10
GROQ_OUTPUT_USD_PER_MTOK=0.50

# ---- Prompt trust boundary ----
# Hard cap on retrieved document text inside the <context> fence, independent
# of top_k: one pathological chunk must not fill the window on its own.
MAX_CONTEXT_CHARS=12000

# ---- Human-approval gate & ops API ----
OPS_API_URL=http://localhost:8001
OPERATOR_NAME=demo_user
# Where the ops stub writes ops_state.json and audit.log.
OPS_DATA_DIR=data
# Timeout in seconds for the gate's call to the ops API.
OPS_REQUEST_TIMEOUT=10
# How long a proposed action stays approvable. An approval screen left open
# overnight must not still be able to change tomorrow's menu.
APPROVAL_TTL_SECONDS=900
